+        else:
+            routing_map_BLE = torch.zeros_like(
+                scores_BLE, dtype=torch.bool
+            ).scatter_(-1, topk_expert_ids_BLK, True)
         num_local_tokens_per_expert_E = routing_map_BLE.sum(dim=(0, 1))
 
