+        if isinstance(scores_BLE, DTensor):
+            local_map = torch.zeros_like(
+                scores_BLE.to_local(), dtype=torch.bool
+            ).scatter_(-1, topk_expert_ids_BLK.to_local(), True)
+            routing_map_BLE = DTensor.from_local(
