Fix: torch._grouped_mm rejects every valid layout for a zero-length contraction dim.

Written against the installed header source; NOT compiled or tested locally
(pip wheel, no build tree). Paths are the upstream ones.

--- a/aten/src/ATen/native/GroupedMMUtils.h
+++ b/aten/src/ATen/native/GroupedMMUtils.h
@@ -25,6 +25,17 @@ inline bool check_valid_strides_and_return_transposed(const Tensor& mat) {
   int end_dim = mat.dim() - 1;
   int alignment = 16 / mat.element_size();
   bool is_cpu = mat.device().is_cpu();
+  // An operand with no elements has no memory to align and no layout to
+  // validate: every stride vector describes the same empty tensor, and the
+  // checks below admit none of them. A [M, 0] matrix has a natural row stride
+  // of 0, which fails `stride >= max(1, size)`, while the stride at::empty
+  // actually produces (1) fails the 16-byte alignment check.
+  //
+  // Reachable from the backward of a grouped GEMM whose group is empty: the
+  // weight gradient contracts over that group's token count. Infer the
+  // orientation from whichever stride is unit, matching the convention below.
+  if (mat.numel() == 0) {
+    return tensor_strides[end_dim] != 1 && tensor_strides[end_dim - 1] == 1;
+  }
