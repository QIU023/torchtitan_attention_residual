+@pytest.mark.parametrize("num_linears", [1, 2])
+def test_qlora_mxfp4_packs_the_base_and_folds_it_back(num_linears):
+    pytest.importorskip("torchao.prototype.mx_formats")
+    torch.manual_seed(0)
+    linear = (
+        LoRATransform(rank=8, alpha=16.0, quantize_base="mxfp4")
+        .transform(
+            Linear.Config(
+                in_features=64,
+                out_features=32,
+                num_linears=num_linears,
+                param_init={"weight": torch.nn.init.normal_},
+            )
+        )
+        .build()
+    )
+    linear.init_states()
+    with torch.no_grad():
+        linear.lora_a.weight.normal_()
+        linear.lora_b.weight.normal_()
+    leading = (32,) if num_linears == 1 else (num_linears, 32)
+
+    assert linear.weight.dtype == torch.uint8
+    assert linear.weight.shape == (*leading, 32)
+    assert linear.weight_scale.shape == (*leading, 2)
+    assert set(linear.state_dict()) == {
+        "weight",
+        "weight_scale",
+        "lora_a.weight",
+        "lora_b.weight",
+    }
+
+    base = _mxfp4_reference(linear.weight, linear.weight_scale).float()
+    delta = 2 * torch.matmul(linear.lora_b.weight, linear.lora_a.weight)
+    input_XI = torch.randn(5, 64, requires_grad=True)
+    actual = linear(input_XI)
+    expected = F.linear(input_XI, (base + delta).flatten(0, -2))
+    torch.testing.assert_close(
+        actual, expected.unflatten(-1, leading), rtol=1e-4, atol=1e-4
+    )
+    actual.sum().backward()
+    assert linear.weight.grad is None
+    assert linear.lora_a.weight.grad is not None
+
+    merged = merge_lora_state_dict(linear)
+    assert set(merged) == {"weight"}
+    torch.testing.assert_close(
+        merged["weight"].float(), (base + delta).bfloat16().float()
+    )
