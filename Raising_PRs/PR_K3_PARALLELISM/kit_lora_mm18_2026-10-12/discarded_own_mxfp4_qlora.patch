+def _mxfp4_reference(weight: torch.Tensor, scale: torch.Tensor) -> torch.Tensor:
+    from torchao.prototype.mx_formats.mx_tensor import to_dtype
+
+    return to_dtype(
+        weight,
+        scale.view(torch.float8_e8m0fnu),
+        torch.float4_e2m1fn_x2,
+        32,
+        torch.bfloat16,
+    )
