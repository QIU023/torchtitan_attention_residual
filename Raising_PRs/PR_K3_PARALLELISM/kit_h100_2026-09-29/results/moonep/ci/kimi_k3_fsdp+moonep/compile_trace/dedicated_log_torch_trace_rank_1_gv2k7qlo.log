	def get_bounded_indices(indices, max_len=None):
	    return indices % max_len if max_len is not None else indices
	
	@triton.jit
	def load_checked_block(block_ptr, IS_DIVISIBLE: tl.constexpr, SAFE_HEAD_DIM: tl.constexpr):
