        optionalArgs = dkwargs.get("optionalArgs", [])
        unitAttrNames = dkwargs.get("unitAttrNames", [])
        valueAttrDict = dkwargs.get("valueAttrDict", {})
        kernelGenHelper = dkwargs.get("kernelGenHelper", None)
    
