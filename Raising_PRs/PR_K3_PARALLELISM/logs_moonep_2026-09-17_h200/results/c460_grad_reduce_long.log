        kernel_attrs = _build_kernel_attrs(config)
        value_attrs = self.dsl._generate_kernel_attrs(config)
        collector = getattr(self.dsl, "_collect_extra_kernel_value_attrs", None)
        if callable(collector):
            value_attrs.update(
