    def kernel(
        self,
        expert_grad: cute.Tensor,
        reduce_buf: cute.Tensor,
        tma_g2s_red: cute.CopyAtom,
        tma_red: cute.Tensor,
        experts: cute.Tensor,
        meta: cute.Tensor,
        bar: cute.Tensor,
        rank: Int32,
        barrier_off: Int32,
