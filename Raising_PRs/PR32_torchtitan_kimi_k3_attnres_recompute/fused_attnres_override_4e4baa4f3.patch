new file mode 100644
index 000000000..3d1fb3d9f
--- /dev/null
+++ b/torchtitan/overrides/fused_attnres.py
@@ -0,0 +1,149 @@
+# Copyright (c) Meta Platforms, Inc. and affiliates.
+# All rights reserved.
+#
+# This source code is licensed under the BSD-style license found in the
+# LICENSE file in the root directory of this source tree.
+
+"""Fused attention residual override for Kimi K3.
+
+``fused_attnres`` replaces every ``AttentionResidual`` aggregation with the
+fused Triton op of flash-linear-attention, which saves per-token statistics
+instead of the FP32 stack and rebuilds the upcasts in backward::
+
+    torchtitan_train ... --override.imports torchtitan.overrides.fused_attnres.fused_attnres
+
+The kernel is opt-in: without ``fla`` (``flash-linear-attention`` at or above
+0.6.0, which introduced ``fla.ops.attnres``), or off CUDA, the aggregation
+falls back to the eager form. For SPMD type checking the op is registered
+with its eager decomposition, so the checker never runs the kernel.
+"""
+
+from __future__ import annotations
+
+import logging
+from dataclasses import dataclass
+from typing import TYPE_CHECKING
+
+import spmd_types as spmd
+import torch
+
+from torchtitan.config import derive, override
+from torchtitan.models.common import Linear
+from torchtitan.models.common.nn_modules import RMSNorm
+from torchtitan.models.kimi_k3.model import AttentionResidual
+from torchtitan.observability.logging import warn_once
+
+logger = logging.getLogger(__name__)
+
+if TYPE_CHECKING:
+    # The type checker always sees fla as importable (resolved to Any via
+    # ``replace-imports-with-any`` in pyproject.toml); the runtime import-error
+    # sentinel below is what makes it a genuine optional dependency.
+    from fla.ops.attnres import fused_attnres as fla_fused_attnres
+    from fla.ops.attnres.fused import FusedAttnresFunction
+
+    _FLA_IMPORT_ERROR: ImportError | None = None
+else:
+    try:
+        from fla.ops.attnres import fused_attnres as fla_fused_attnres
+        from fla.ops.attnres.fused import FusedAttnresFunction
+
+        _FLA_IMPORT_ERROR = None
+    except ImportError as e:
+        fla_fused_attnres = None
+        FusedAttnresFunction = None
+        _FLA_IMPORT_ERROR = e
+
+__all__ = ["FusedAttentionResidual", "fused_attnres"]
+
+
+def _eager_attnres(
+    query: torch.Tensor,
+    rms_weight: torch.Tensor,
+    output_rms_weight: torch.Tensor | None,
+    rms_eps: float,
+    scale: float,
+    return_weights: bool,
+    checkpoint_level: int,
+    *residuals: torch.Tensor,
+) -> tuple[torch.Tensor, torch.Tensor]:
+    """The fused op as plain ops, with its signature and outputs: the SPMD type
+    checker traces this on meta tensors, since the Triton kernel cannot run there."""
+    del checkpoint_level
+    values_TLD = torch.stack([r.float() for r in residuals], dim=1)
+    variance = values_TLD.pow(2).mean(dim=-1, keepdim=True)
+    keys_TLD = values_TLD * torch.rsqrt(variance + rms_eps)
+    score_weight_D = rms_weight.float() * query.float() * scale
+    scores_TL = (keys_TLD * score_weight_D).sum(dim=-1)
+    probs_TL = torch.softmax(scores_TL, dim=-1)
+    output_TD = torch.matmul(probs_TL.unsqueeze(1), values_TLD).squeeze(1)
+    if output_rms_weight is not None:
+        output_TD = torch.nn.functional.rms_norm(
+            output_TD, (output_TD.shape[-1],), output_rms_weight.float(), rms_eps
+        )
+    # Only the types of the outputs are read, and they must have the op's
+    # ranks: the probabilities [L, T] when they are requested, else a
+    # per-token vector standing in for the op's empty one (a fresh tensor
+    # would type as replicated).
+    probs = probs_TL.transpose(0, 1) if return_weights else scores_TL.logsumexp(-1)
+    return output_TD.to(residuals[0].dtype), probs
+
+
+if _FLA_IMPORT_ERROR is None:
+    spmd.register_decomposition(FusedAttnresFunction, _eager_attnres)
+    # fla dispatches to a Gluon backend where it can; it has the same signature.
+    try:
+        from fla.ops.attnres.backends.gluon import FusedAttnresGluonFunction
+    except ImportError:
+        pass
+    else:
+        spmd.register_decomposition(FusedAttnresGluonFunction, _eager_attnres)
+
+
+class FusedAttentionResidual(AttentionResidual):
+    """Kimi's attention residual through flash-linear-attention's fused op."""
+
+    @dataclass(kw_only=True, slots=True)
+    class Config(AttentionResidual.Config):
+        pass
+
+    def __call__(
+        self,
+        prefix_sum_TD: torch.Tensor,
+        block_residual_TND: torch.Tensor,
+        projection: Linear,
+        norm: RMSNorm,
+    ) -> torch.Tensor:
+        if _FLA_IMPORT_ERROR is not None:
+            warn_once(
+                logger,
+                "fused_attnres: fla.ops.attnres is not importable "
+                f"({_FLA_IMPORT_ERROR}); falling back to the eager aggregation.",
+            )
+            return super().__call__(prefix_sum_TD, block_residual_TND, projection, norm)
+        if not prefix_sum_TD.is_cuda:
+            warn_once(
+                logger,
+                "fused_attnres: the fused op needs CUDA tensors; falling back to "
+                "the eager aggregation.",
+            )
+            return super().__call__(prefix_sum_TD, block_residual_TND, projection, norm)
+        assert norm.eps is not None
+        # The op reads sources as rows: the stack's per-block views are copied
+        # once into contiguous [T, D] tensors, and the running sum is the last
+        # source, as in the eager form.
+        return fla_fused_attnres(
+            projection.weight.squeeze(0),
+            [*block_residual_TND.unbind(dim=1), prefix_sum_TD],
+            norm.weight,
+            rms_eps=norm.eps,
+        )
+
+
+@override(
+    target=AttentionResidual.Config,
+    exact=True,
+    description="Fuse Kimi's attention residual aggregation with flash-linear-attention.",
+)
+def fused_attnres(cfg: AttentionResidual.Config) -> FusedAttentionResidual.Config:
+    return derive(cfg, FusedAttentionResidual.Config)
