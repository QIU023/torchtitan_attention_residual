+
+import types
+import unittest
+from typing import cast
+
+import torch
+
+from torchtitan.config import apply_overrides, OverrideConfig
+from torchtitan.models.kimi_k3.config_registry import kimi_k3_debugmodel
+from torchtitan.models.kimi_k3.model import AttentionResidual, KimiK3Model
+from torchtitan.overrides import fused_attnres as fused_attnres_module
+from torchtitan.overrides.fused_attnres import FusedAttentionResidual
+
+EPS = 1e-5
+_FLA = fused_attnres_module._FLA_IMPORT_ERROR is None
+
+
+def _grad(leaf: torch.Tensor) -> torch.Tensor:
+    assert leaf.grad is not None
+    return leaf.grad.detach().float().clone()
+
+
+def _modules(projection: torch.Tensor, norm_weight: torch.Tensor):
+    return (
+        types.SimpleNamespace(weight=projection),
+        types.SimpleNamespace(weight=norm_weight, eps=EPS),
+    )
+
+
+def _inputs(tokens, blocks, dim, dtype, device, seed=0):
+    generator = torch.Generator().manual_seed(seed)
+
+    def make(*shape, scale=1.0):
+        return (torch.randn(*shape, generator=generator) * scale).to(dtype).to(device)
+
+    return (
+        make(tokens, dim).requires_grad_(),
+        make(tokens, blocks, dim).requires_grad_(),
+        make(1, dim, scale=dim**-0.5).requires_grad_(),
+        (1 + 0.1 * torch.randn(dim, generator=generator))
+        .to(dtype)
+        .to(device)
+        .requires_grad_(),
+        make(tokens, dim),
+    )
+
+
+class TestFusedAttnresOverrideConfig(unittest.TestCase):
+    def test_override_replaces_every_aggregation(self):
+        config = kimi_k3_debugmodel(seq_len=512)
+        model_config = cast(KimiK3Model.Config, config.model)
+        replacements = apply_overrides(
+            OverrideConfig(
+                imports=["torchtitan.overrides.fused_attnres.fused_attnres"]
+            ),
+            config,
+        )
+        # Two per layer (layer 0's attention one is built but unused) and the
+        # output one.
+        self.assertEqual(len(replacements), 2 * len(model_config.layers) + 1)
+        for layer in model_config.layers:
+            self.assertIsInstance(layer.attention_res_fn, FusedAttentionResidual.Config)
+            self.assertIsInstance(layer.ffn_res_fn, FusedAttentionResidual.Config)
+        self.assertIsInstance(model_config.output_res_fn, FusedAttentionResidual.Config)
+
+    def test_falls_back_to_eager_off_cuda(self):
+        prefix, stack, projection, norm_weight, _ = _inputs(
+            16, 3, 8, torch.float32, "cpu"
+        )
+        expected = AttentionResidual.Config().build()(
+            prefix, stack, *_modules(projection, norm_weight)
+        )
+        actual = FusedAttentionResidual.Config().build()(
+            prefix, stack, *_modules(projection, norm_weight)
+        )
+        torch.testing.assert_close(actual, expected)
+
+
+@unittest.skipUnless(
+    torch.cuda.is_available() and _FLA, "the fused aggregation needs CUDA and fla"
+)
+class TestFusedAttnresNumerics(unittest.TestCase):
+    def _compare(self, tokens, blocks, dim, dtype, rtol, atol):
+        prefix, stack, projection, norm_weight, grad_output = _inputs(
+            tokens, blocks, dim, dtype, "cuda"
+        )
+        leaves = [prefix, stack, projection, norm_weight]
+        outputs, grads = [], []
+        for aggregate in (
+            AttentionResidual.Config().build(),
+            FusedAttentionResidual.Config().build(),
+        ):
+            for leaf in leaves:
+                leaf.grad = None
+            output = aggregate(prefix, stack, *_modules(projection, norm_weight))
+            output.backward(grad_output)
+            outputs.append(output.detach().float())
+            grads.append([_grad(leaf) for leaf in leaves])
+        torch.testing.assert_close(outputs[1], outputs[0], rtol=rtol, atol=atol)
+        for expected, actual in zip(*grads, strict=True):
+            torch.testing.assert_close(actual, expected, rtol=rtol, atol=atol)
+
+    def test_matches_eager_in_float32(self):
+        self._compare(128, 3, 64, torch.float32, rtol=1e-5, atol=1e-5)
+
+    def test_matches_eager_in_bfloat16(self):
+        # The fused op rounds once at the end, as the eager form does; the
+        # remaining gap is the FP32 reduction order.
+        self._compare(2048, 7, 1024, torch.bfloat16, rtol=1e-2, atol=1e-2)
+
+
+if __name__ == "__main__":
+    unittest.main()
