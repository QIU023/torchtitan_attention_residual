From f23d666f015e487057fa9ed641b9270743c0d9b4 Mon Sep 17 00:00:00 2001
From: QIU023 <yiqiaoqiu@hotmail.com>
Date: Tue, 18 Aug 2026 06:55:14 +0000
Subject: [PATCH 1/3] DTensor: _foreach_norm.Scalar shares vector_norm's
 strategy but has no dim

vector_norm_single_dim_strategy is registered for linalg_vector_norm, norm.Scalar, and
_foreach_norm.Scalar. The first two have schema (input, ord, dim, keepdim, *, dtype); the
strategy reads args_schema[2] as dim. But _foreach_norm.Scalar is (self, ord, *, dtype),
so its position 2 is dtype -- and torch._foreach_norm(tensors, ord, dtype=torch.float32)
lands the dtype in the dim slot, where normalize_dim raises
'>=' not supported between instances of torch.dtype and int.

_foreach_norm reduces each tensor fully and dtype does not affect placement, so this sets
dim=None for that overload and leaves vector_norm/norm unchanged. Without the dtype kwarg
the bug is latent because position 2 is out of range and dim defaults to None.
---
 torch/distributed/tensor/_ops/_math_ops.py | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/torch/distributed/tensor/_ops/_math_ops.py b/torch/distributed/tensor/_ops/_math_ops.py
index 89ddcfeb2a..cbce092fa8 100644
--- a/torch/distributed/tensor/_ops/_math_ops.py
+++ b/torch/distributed/tensor/_ops/_math_ops.py
@@ -949,8 +949,14 @@ def vector_norm_single_dim_strategy(
     norm_type = args_schema[1] if len(args_schema) > 1 else 2
     if not isinstance(norm_type, (int, float, str)):
         raise AssertionError(f"Expected int, float, or str, got {type(norm_type)}")
-    dim = args_schema[2] if len(args_schema) > 2 else None
-    keepdim = args_schema[3] if len(args_schema) > 3 else False
+    # Specialize for _foreach_norm.Scalar since it reduces each tensor fully and
+    # has no dim/keepdim (its schema is (self, ord, *, dtype)).
+    if op == aten._foreach_norm.Scalar:
+        dim = None
+        keepdim = False
+    else:
+        dim = args_schema[2] if len(args_schema) > 2 else None
+        keepdim = args_schema[3] if len(args_schema) > 3 else False
     dims = _infer_reduction_dims(dim, ndim)
 
     return _reduction_single_dim_strategy(
